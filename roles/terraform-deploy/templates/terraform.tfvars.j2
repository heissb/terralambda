# Terraform variables for {{ terraform_workspace }} environment
# Generated by Ansible on {{ ansible_date_time.iso8601 }}

aws_region = "{{ aws_region }}"
function_name = "{{ terraform_vars.function_name }}"
handler = "{{ terraform_vars.handler }}"
runtime = "{{ terraform_vars.runtime }}"
timeout = {{ terraform_vars.timeout }}
memory_size = {{ terraform_vars.memory_size }}
log_retention_days = {{ terraform_vars.log_retention_days }}
enable_api_gateway = {{ terraform_vars.enable_api_gateway | lower }}
cors_allowed_origins = {{ terraform_vars.cors_allowed_origins | to_nice_json }}
enable_alarms = {{ terraform_vars.enable_alarms | lower }}

{% if terraform_vars.tags is defined %}
tags = {
{% for key, value in terraform_vars.tags.items() %}
  {{ key }} = "{{ value }}"
{% endfor %}
}
{% endif %}
